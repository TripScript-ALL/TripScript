APP_NAME=TripScript Backend
APP_ENV=local
DEBUG=false
ENABLE_API_DOCS=false
ENABLE_ADMIN_API=false
ENABLE_LEGACY_AUTH=false
CORS_ORIGINS=[]
API_PREFIX=/api

DATABASE_URL=sqlite:///./storage/tripscript.db
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

STORAGE_DIR=storage
ADMIN_API_TOKEN=

# Receipt recognition.
# The default path uses a local multimodal Ollama model to read the image and
# return JSON directly. Tesseract/LightOnOCR remain available as fallback providers.
RECEIPT_OCR_PROVIDER=easyocr_service
RECEIPT_OCR_LANGS=eng+kor+jpn
RECEIPT_OCR_PSM=6
RECEIPT_OCR_PSM_MODES=4,6,11
RECEIPT_OCR_SERVICE_URL=http://ocr:8010
RECEIPT_EASYOCR_SERVICE_URL=http://easyocr:8011
RECEIPT_IMAGE_PREPROCESS_ENABLED=true
RECEIPT_RECOGNITION_STRATEGY=cloud_gemini
RECEIPT_VISION_FALLBACK_OCR_ENABLED=true
RECEIPT_HYBRID_VISION_FALLBACK_ENABLED=false
RECEIPT_VISION_FLATTEN_ENABLED=true
RECEIPT_VISION_INCLUDE_ORIGINAL_ENABLED=false
RECEIPT_RULE_FIRST_ENABLED=true
RECEIPT_LLM_PROVIDER=ollama_vision
RECEIPT_LLM_MODEL=qwen2.5vl:7b
RECEIPT_TEXT_LLM_MODEL=qwen2.5:1.5b
RECEIPT_TEXT_LLM_NUM_CTX=4096
RECEIPT_TEXT_LLM_NUM_PREDICT=350
RECEIPT_TEXT_LLM_TIMEOUT_SECONDS=22
# Optional cloud vision path for comparison only.
# Use recognitionStrategy=cloud_gemini or /receipts/recognize/compare.
RECEIPT_GEMINI_API_KEY=
RECEIPT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RECEIPT_GEMINI_MODEL=gemini-2.5-flash
RECEIPT_CLOUD_LLM_TIMEOUT_SECONDS=45
RECEIPT_CLOUD_LLM_IMAGE_MAX_EDGE=1600
RECEIPT_CLOUD_LLM_IMAGE_JPEG_QUALITY=90
RECEIPT_CLOUD_LLM_FLATTEN_ENABLED=true
RECEIPT_LLM_BASE_URL=http://ollama:11434
RECEIPT_LLM_API_KEY=
RECEIPT_LLM_PIPELINE=fast
RECEIPT_LLM_KEEP_ALIVE=2m
RECEIPT_LLM_REPAIR_ENABLED=true
RECEIPT_RECOGNITION_TIMEOUT_SECONDS=180
RECEIPT_LLM_IMAGE_MAX_EDGE=1600
RECEIPT_LLM_IMAGE_JPEG_QUALITY=92
RECEIPT_LLM_NUM_CTX=8192
RECEIPT_LLM_NUM_PREDICT=900
RECEIPT_QWEN_SAFE_RESIZE_ENABLED=true
RECEIPT_QWEN_SAFE_RESIZE_EDGE=1344
RECEIPT_LLM_KEEP_WARM_ENABLED=false
RECEIPT_LLM_KEEP_WARM_INTERVAL_SECONDS=900
CARD_FEE_RESEARCH_ENABLED=true
CARD_FEE_RESEARCH_MODEL=qwen2.5:3b
CARD_FEE_RESEARCH_TIMEOUT_SECONDS=90
CARD_FEE_RESEARCH_MAX_SOURCES=4

# Optional public tunnel for mobile testing outside the local/Tailscale network.
# Copy these to .env on the server before running docker-compose.ngrok.yml.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
